# Copy this file to .env and fill in your values
# Never commit .env to version control

# SMTP settings — use your email provider's SMTP details
# Gmail example: smtp.gmail.com, port 587, secure false
# For Gmail you need an App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bazilkimaro05@gmail.com
SMTP_PASS=your-app-password-here

# Where consultation requests get delivered
RECIPIENT_EMAIL=michael.kehongoh@sematanzania.org
PORT=3000
